{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } },
  "AllowedHosts": "*",
  "ConnectionStrings": { "Auth": "Data Source=data/auth.db" },
  "Auth": {
    "Issuer": "https://auth.local",
    "Audience": "auth-demo-api",
    "AccessTokenLifetime": "00:05:00",
    "SessionIdleLifetime": "7.00:00:00",
    "MaxFailedLogins": 5,
    "LockoutWindow": "00:15:00",
    "SigningKeyPath": "data/signing-key.pem",
    "SeedSampleAccounts": true
  }
}
